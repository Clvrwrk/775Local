# Public directory read path
VITE_PUBLIC_SUPABASE_URL=https://preview-project-ref.supabase.co
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# WorkOS AuthKit server session
WORKOS_CLIENT_ID=client_replace_me
WORKOS_API_KEY=sk_test_replace_me
WORKOS_REDIRECT_URI=http://localhost:8080/api/auth/callback
WORKOS_COOKIE_PASSWORD=replace_with_at_least_32_random_characters
WORKOS_COOKIE_MAX_AGE=604800

# Server runtime Supabase API path; the publishable key carries no privileged authority.
SUPABASE_URL=https://preview-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only identity projection; never prefix this with VITE_
SUPABASE_SERVICE_ROLE_KEY=replace_with_preview_service_role_key
